# Copy to backend/.env for local development. Never commit the real .env file.
DB_HOST=localhost
DB_PORT=3306
DB_USER=indeed_flow
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=indeed_flow

# Generate independent, high-entropy values for every entry below.
SITE_ACCESS_TOKEN=replace-with-a-long-random-access-token
FLASK_SECRET_KEY=replace-with-a-long-random-session-secret
CLIPBOARD_API_KEY=replace-with-a-long-random-clipboard-key
LLM_API_KEY=
RAWG_API_KEY=
